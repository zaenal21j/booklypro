<% content_for :title, "Book Glow Studio — BooklyPro" %>
<section class="min-h-screen bg-ivory pb-24 pt-28 sm:pt-36"><div class="page-shell max-w-5xl"><%= link_to "← Back to Glow Studio", glow_studio_path, class: "secondary-link" %><div class="mt-8 flex flex-wrap items-center justify-between gap-5 border-b border-line pb-7"><div><p class="eyebrow mb-3">Glow Studio · Kemang</p><h1 class="font-display text-5xl leading-none sm:text-6xl">Make time for yourself.</h1></div><p class="max-w-xs text-sm leading-6 text-muted">A presentation-only booking flow. Your choices are ready to review in the final step.</p></div>
  <div class="my-8 flex items-center justify-between gap-2 sm:justify-start sm:gap-12"><%= render "shared/booking_step", number: 1, label: "Service", active: true %><span class="h-px flex-1 bg-line sm:max-w-20"></span><%= render "shared/booking_step", number: 2, label: "Professional", active: false %><span class="h-px flex-1 bg-line sm:max-w-20"></span><%= render "shared/booking_step", number: 3, label: "Date & time", active: false %><span class="h-px flex-1 bg-line sm:max-w-20"></span><%= render "shared/booking_step", number: 4, label: "Confirm", active: false %></div>
  <div class="grid gap-10 lg:grid-cols-[1fr_20rem]"><div class="space-y-12"><div><%= render "shared/section_heading", eyebrow: "Step 1 · Choose a service", title: "What would you like today?", description: "Select one treatment to continue. You can edit it later." %><div class="grid gap-3"><% @services.each_with_index do |service, i| %><label class="group flex cursor-pointer items-start gap-4 rounded-2xl border <%= i.zero? ? "border-copper shadow-soft" : "border-line" %> bg-white p-5 transition hover:border-copper"><input type="radio" name="service" <%= "checked" if i.zero? %> class="mt-1 size-4 accent-ink"><span class="flex-1"><span class="flex flex-wrap items-baseline justify-between gap-3"><strong><%= service[:name] %></strong><strong class="text-sm"><%= service[:price] %></strong></span><span class="mt-1 block text-xs text-muted"><%= service[:duration] %></span><span class="mt-3 block text-sm leading-6 text-muted"><%= service[:description] %></span></span></label><% end %></div></div>
    <div><%= render "shared/section_heading", eyebrow: "Step 2 · Choose a professional", title: "Someone who gets your style." %><div class="grid gap-3 sm:grid-cols-2"><% @professionals.each do |professional| %><%= render "shared/booking_option", field: "professional", name: professional[:name], specialty: professional[:specialty], note: professional[:note], image: professional[:image] %><% end %></div></div>
    <div><%= render "shared/section_heading", eyebrow: "Step 3 · Choose a date & time", title: "When would you like to come in?" %><div class="rounded-3xl border border-line bg-white p-5 sm:p-7"><div class="flex items-center justify-between"><button aria-label="Previous month">←</button><strong>September 2026</strong><button aria-label="Next month">→</button></div><div class="mt-6 grid grid-cols-3 gap-2 sm:grid-cols-6"><% @dates.each_with_index do |date, i| %><button class="rounded-xl border <%= i == 1 ? "border-ink bg-ink text-white" : "border-line" %> px-2 py-3 text-xs font-semibold"><%= date %></button><% end %></div><div class="mt-7 grid gap-6 sm:grid-cols-2"><% @times.each do |group, times| %><div><p class="mb-3 text-xs font-bold uppercase tracking-wider text-muted"><%= group %></p><div class="grid grid-cols-2 gap-2"><% times.each_with_index do |time, i| %><button class="rounded-xl border <%= group == "Morning" && i == 1 ? "border-copper bg-cream" : "border-line" %> py-3 text-sm font-semibold"><%= time %></button><% end %></div></div><% end %></div></div></div>
    <div><%= render "shared/section_heading", eyebrow: "Step 4 · Confirm", title: "Everything looks lovely." %><div class="rounded-3xl border border-line bg-white p-6 sm:p-8"><div class="space-y-4 text-sm"><div class="flex justify-between gap-5"><span class="text-muted">Studio</span><strong>Glow Studio</strong></div><div class="flex justify-between gap-5"><span class="text-muted">Service</span><strong>Signature Haircut</strong></div><div class="flex justify-between gap-5"><span class="text-muted">Professional</span><strong>Any available</strong></div><div class="flex justify-between gap-5"><span class="text-muted">Date & time</span><strong>Wed 17 · 09:45</strong></div><div class="flex justify-between gap-5 border-t border-line pt-4"><span class="text-muted">Total · 45 min</span><strong>Rp 85.000</strong></div></div><div class="mt-7 rounded-2xl bg-sand p-4 text-sm"><p class="font-semibold">Customer details</p><p class="mt-1 text-muted">You’ll add your contact details before confirming.</p><p class="mt-3 text-xs font-semibold text-copper">Pay at venue · No payment today</p></div><button class="mt-7 min-h-12 w-full rounded-full bg-ink px-6 text-sm font-semibold text-white transition hover:bg-charcoal">Confirm booking <span aria-hidden="true">→</span></button></div></div>
  </div><aside class="hidden lg:block"><div class="sticky top-28 rounded-3xl border border-line bg-white p-6 shadow-card"><p class="eyebrow mb-4">Your appointment</p><h2 class="font-display text-3xl">Glow Studio</h2><p class="mt-2 flex items-center gap-2 text-sm text-muted"><%= icon "pin", class_name: "size-4" %>Kemang, Jakarta Selatan</p><div class="mt-8 space-y-4 border-t border-line pt-5 text-sm"><p class="flex justify-between"><span class="text-muted">Selected service</span><strong>Signature Haircut</strong></p><p class="flex justify-between"><span class="text-muted">From</span><strong>Rp 85.000</strong></p></div></div></aside></div></div></section>
