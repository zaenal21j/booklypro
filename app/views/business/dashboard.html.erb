<% content_for :title, "Business dashboard — BooklyPro" %>
<div class="min-h-screen bg-[#f2f0eb] text-ink"><div class="flex min-h-screen"><aside class="hidden w-64 shrink-0 flex-col bg-ink px-5 py-7 text-white lg:flex"><%= link_to "BooklyPro", root_path, class: "font-display text-3xl" %><p class="mt-1 text-[10px] font-bold uppercase tracking-[.2em] text-white/45">Business</p><nav class="mt-12 space-y-2"><% @nav_items.each_with_index do |(symbol, label), i| %><a href="#" class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm transition <%= i.zero? ? "bg-white/15 text-white" : "text-white/60 hover:bg-white/10 hover:text-white" %>"><span class="grid size-5 place-items-center text-base"><%= symbol %></span><%= label %></a><% end %></nav><div class="mt-auto rounded-2xl bg-white/10 p-4"><div class="flex items-center gap-3"><span class="avatar bg-copper">O</span><span><strong class="block text-sm">Olivia</strong><span class="text-xs text-white/50">Owner</span></span></div></div></aside><main class="min-w-0 flex-1"><header class="flex items-center justify-between border-b border-black/5 bg-[#f8f7f4] px-5 py-5 sm:px-8 lg:px-12"><div class="flex items-center gap-3"><button class="grid size-10 place-items-center rounded-xl border border-black/10 bg-white lg:hidden" aria-label="Open navigation">☰</button><div><p class="text-xs font-semibold uppercase tracking-wider text-muted">Sunday, 13 September 2026</p><h1 class="mt-1 font-display text-3xl sm:text-4xl">Good morning, Olivia <span class="text-copper">✦</span></h1></div></div><div class="flex items-center gap-3"><button class="grid size-10 place-items-center rounded-xl border border-black/10 bg-white" aria-label="Notifications">♧</button><span class="avatar bg-copper">O</span></div></header><div class="px-5 py-8 sm:px-8 lg:px-12 lg:py-10"><p class="text-sm text-muted">Here's what's happening at Glow Studio today.</p><div class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4"><% [["Revenue", "Rp 4.850.000", "+12%", "green"], ["Bookings", "23", "+5%", "green"], ["New Clients", "6", "+20%", "green"], ["Utilization", "82%", "This week", "amber"]].each do |label, value, change, tone| %><div class="rounded-2xl border border-black/5 bg-white p-5 shadow-card"><p class="text-sm text-muted"><%= label %></p><p class="mt-4 font-display text-3xl"><%= value %></p><p class="mt-2 text-xs font-semibold <%= tone == "green" ? "text-emerald-700" : "text-copper" %>"><%= change %></p></div><% end %></div><div class="mt-8 grid gap-6 xl:grid-cols-[1.35fr_.65fr]"><section class="rounded-3xl border border-black/5 bg-white p-5 shadow-card sm:p-7"><div class="flex items-center justify-between"><div><h2 class="font-display text-3xl">Today’s appointments</h2><p class="mt-1 text-xs text-muted">Sun, 13 Sep 2026</p></div><button class="rounded-full border border-line px-4 py-2 text-xs font-semibold">View calendar →</button></div><div class="mt-7 space-y-1"><% @appointments.each do |time, client, service, professional, status, tone| %><div class="grid grid-cols-[3.5rem_1fr_auto] items-center gap-3 border-t border-line py-4 sm:grid-cols-[4rem_1fr_7rem_auto]"><span class="text-xs font-semibold text-muted"><%= time %></span><div><strong class="block text-sm"><%= client %></strong><span class="mt-1 block text-xs text-muted"><%= service %> · <%= professional %></span></div><span class="hidden text-xs text-muted sm:block"><%= professional %></span><span class="justify-self-end rounded-full px-3 py-1.5 text-[11px] font-semibold <%= tone == "green" ? "bg-emerald-50 text-emerald-700" : tone == "blue" ? "bg-blue-50 text-blue-700" : "bg-amber-50 text-amber-700" %>"><%= status %></span></div><% end %></div></section><aside class="space-y-6"><section class="rounded-3xl border border-black/5 bg-ink p-6 text-white shadow-card"><p class="text-xs font-bold uppercase tracking-wider text-white/50">This week</p><h2 class="mt-2 font-display text-3xl">A steady rhythm</h2><div class="mt-7 flex h-28 items-end gap-2"><% [40, 58, 48, 76, 64, 88, 70].each do |height| %><span class="flex-1 rounded-t-md bg-champagne/70" style="height: <%= height %>%"></span><% end %></div><div class="mt-3 flex justify-between text-[10px] text-white/45"><span>Mon</span><span>Sun</span></div></section><section class="rounded-3xl border border-black/5 bg-white p-6 shadow-card"><p class="text-xs font-bold uppercase tracking-wider text-muted">Top services</p><div class="mt-5 space-y-4"><% [["Signature Haircut", "38%"], ["Hair Coloring", "27%"], ["Hair Treatment", "21%"]].each do |service, percent| %><div><div class="flex justify-between text-xs font-semibold"><span><%= service %></span><span><%= percent %></span></div><div class="mt-2 h-1.5 rounded-full bg-sand"><div class="h-1.5 rounded-full bg-copper" style="width: <%= percent %>"></div></div></div><% end %></div></section></aside></div></div></main></div></div>
