<% content_for :title, "Sign in — BooklyPro" %><%= render "devise/shared/auth_shell" do %><h1 class="font-display text-5xl leading-none">Welcome back.</h1><p class="mt-4 text-sm leading-6 text-muted">Sign in to manage your appointments and discover your next ritual.</p><%= render "devise/shared/error_messages", resource: resource %><%= form_for(resource, as: resource_name, url: session_path(resource_name), class: "mt-8 space-y-5") do |f| %><div><%= f.label :email, class: "form-label" %><%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-input" %></div><div><div class="flex justify-between"><%= f.label :password, class: "form-label" %><%= link_to "Forgot password?", new_password_path(resource_name), class: "text-xs font-semibold text-copper hover:underline" %></div><%= f.password_field :password, autocomplete: "current-password", class: "form-input" %></div><label class="flex items-center gap-2 text-sm text-muted"><%= f.check_box :remember_me, class: "size-4 accent-ink" %> Remember me</label><%= f.submit "Sign in", class: "auth-submit" %><p class="text-center text-sm text-muted">New to BooklyPro? <%= link_to "Create an account", new_registration_path(resource_name), class: "font-semibold text-ink underline-offset-4 hover:underline" %></p><% end %><div class="relative py-2 text-center text-xs text-muted before:absolute before:left-0 before:top-1/2 before:h-px before:w-full before:bg-line"><span class="relative bg-ivory px-3">or continue with</span></div><div class="grid grid-cols-2 gap-3"><%= button_to "Continue with Google", user_google_oauth2_omniauth_authorize_path, method: :post, class: "auth-social" %><%= button_to "Continue with Facebook", user_facebook_omniauth_authorize_path, method: :post, class: "auth-social" %></div><% end %>
