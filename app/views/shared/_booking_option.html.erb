<label class="group relative flex min-h-40 cursor-pointer flex-col rounded-2xl border border-line bg-white p-4 transition hover:-translate-y-1 hover:border-copper hover:shadow-soft sm:p-5"><input type="radio" name="<%= field %>" checked class="absolute right-4 top-4 size-4 accent-ink"><% if name == "Any available professional" %><span class="mb-4 grid size-16 place-items-center rounded-full bg-sand text-2xl text-copper ring-4 ring-cream" aria-hidden="true">✦</span><% else %><%= image_tag image, alt: name, class: "mb-4 size-16 rounded-full object-cover object-top ring-4 ring-cream" %><% end %><strong class="block pr-7 text-sm leading-5"><%= name %></strong><span class="mt-1 block text-xs text-muted"><%= specialty %></span><span class="mt-auto pt-3 text-xs font-semibold text-copper"><%= note %></span></label>
