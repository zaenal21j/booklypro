<label class="group flex cursor-pointer items-start gap-4 rounded-2xl border border-copper bg-white p-4 shadow-soft transition hover:border-copper sm:p-5"><input type="radio" name="<%= field %>" checked class="mt-1 size-4 accent-ink"><%= image_tag image, alt: name, class: "size-14 rounded-xl object-cover object-top" %><span class="min-w-0 flex-1"><strong class="block text-sm"><%= name %></strong><span class="mt-1 block text-xs text-muted"><%= specialty %></span><span class="mt-2 block text-xs text-copper"><%= note %></span></span><span class="text-ink">✓</span></label>
