<label class="group relative flex min-h-44 cursor-pointer flex-col rounded-2xl border border-line bg-white p-4 transition hover:-translate-y-0.5 hover:border-copper hover:shadow-card sm:p-5"><input type="radio" name="<%= field %>" checked class="absolute right-4 top-4 size-4 accent-ink"><%= image_tag image, alt: name, class: "mb-4 size-16 rounded-full object-cover object-top ring-4 ring-cream" %><strong class="block pr-7 text-sm leading-5"><%= name %></strong><span class="mt-1 block text-xs text-muted"><%= specialty %></span><span class="mt-auto pt-3 text-xs font-semibold text-copper"><%= note %></span></label>
