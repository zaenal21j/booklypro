<% style ||= :primary %>
<% classes = style == :primary ? "bg-ink text-white hover:bg-charcoal" : "border border-line bg-white/70 text-ink hover:bg-white" %>
<%= link_to label, href, class: "inline-flex min-h-11 items-center justify-center rounded-full px-6 text-sm font-semibold transition #{classes}" %>
