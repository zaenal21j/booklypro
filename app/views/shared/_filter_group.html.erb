<fieldset class="border-b border-line pb-7 last:border-0">
  <legend class="mb-4 text-sm font-bold"><%= title %></legend>
  <div class="space-y-3">
    <% options.each do |option| %>
      <label class="flex cursor-pointer items-center gap-3 text-sm text-muted transition hover:text-ink">
        <input type="checkbox" class="size-4 rounded border-line accent-ink"><span><%= option %></span>
      </label>
    <% end %>
  </div>
</fieldset>
