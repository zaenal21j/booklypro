<article class="rounded-3xl border border-line bg-white p-5 shadow-card">
  <%= image_tag professional[:image], alt: professional[:name], class: "aspect-[4/3] w-full rounded-2xl object-cover object-top" %>
  <h3 class="mt-5 font-display text-2xl"><%= professional[:name] %></h3>
  <p class="mt-1 text-sm font-semibold"><%= professional[:specialty] %></p>
  <div class="mt-3 flex items-center justify-between text-xs text-muted"><span><%= professional[:note] %></span><span class="text-ink"><span class="text-gold">★</span> <%= professional[:rating] %></span></div>
</article>
