<%= link_to "#popular", class: "group flex min-w-20 flex-col items-center gap-3 rounded-2xl px-1 py-2 outline-none sm:min-w-24 focus-visible:bg-sand" do %>
  <span class="grid size-[4.5rem] place-items-center rounded-full border border-line bg-white text-copper transition duration-300 group-hover:-translate-y-1 group-hover:border-copper group-hover:bg-cream group-hover:shadow-soft group-focus-visible:-translate-y-1 group-focus-visible:border-copper group-focus-visible:shadow-soft sm:size-[5.25rem]"><%= icon icon_name, class_name: "size-7 sm:size-8" %></span>
  <span class="text-sm font-semibold transition group-hover:text-copper group-focus-visible:text-copper sm:text-[15px]"><%= name %></span>
<% end %>
