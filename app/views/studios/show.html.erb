<% content_for :title, "Glow Studio — BooklyPro" %>
<section class="bg-ivory pb-24 pt-20 sm:pt-24">
  <div class="page-shell">
    <div class="grid gap-2 overflow-hidden rounded-[2rem] sm:grid-cols-[1.35fr_.65fr] sm:grid-rows-2 sm:gap-3"><%= image_tag "studio-glow.jpg", alt: "Glow Studio interior", class: "h-72 w-full object-cover sm:row-span-2 sm:h-[31rem]" %><%= image_tag "ritual-detail.jpg", alt: "Glow Studio treatment room", class: "hidden h-full w-full object-cover sm:block" %><%= image_tag "studio-luna.jpg", alt: "Glow Studio styling space", class: "hidden h-full w-full object-cover sm:block" %></div>
    <div class="flex flex-col gap-5 border-b border-line py-8 sm:flex-row sm:items-end sm:justify-between"><div><p class="eyebrow mb-3">Beauty studio · Jakarta Selatan</p><h1 class="font-display text-6xl leading-none sm:text-7xl">Glow Studio</h1><div class="mt-4 flex flex-wrap items-center gap-4 text-sm"><%= render "shared/rating", rating: "4.9", reviews: 328 %><span class="flex items-center gap-1.5 text-muted"><%= icon "pin", class_name: "size-4" %>Kemang, Jakarta Selatan</span><span class="text-muted">Open until 21:00</span></div></div><div class="flex gap-2"><button class="grid size-12 place-items-center rounded-full border border-line bg-white hover:text-copper" aria-label="Save Glow Studio"><%= icon "heart" %></button><button class="grid size-12 place-items-center rounded-full border border-line bg-white hover:text-copper" aria-label="Share Glow Studio"><%= icon "share" %></button></div></div>
    <nav class="no-scrollbar flex gap-7 overflow-x-auto border-b border-line py-5 text-sm font-semibold" aria-label="Studio sections"><a href="#overview">Overview</a><a href="#services">Services</a><a href="#staff">Staff</a><a href="#reviews">Reviews</a><a href="#location">Location</a></nav>
    <div class="grid gap-16 py-12 lg:grid-cols-[1.1fr_.9fr]" id="overview"><div><%= render "shared/section_heading", eyebrow: "The Glow experience", title: "A little time, entirely for you.", description: "Glow Studio is a modern beauty space for thoughtful hair, nail, and facial rituals. Our artists take the time to understand your style and make every visit feel easy.", link_text: nil, href: nil %><div class="mt-10 grid grid-cols-2 gap-3"><%= image_tag "studio-glow.jpg", alt: "Glow Studio detail", class: "aspect-square rounded-2xl object-cover" %><%= image_tag "ritual-detail.jpg", alt: "Glow Studio treatment", class: "aspect-square rounded-2xl object-cover" %></div></div><div class="rounded-3xl border border-line bg-white p-6 sm:p-8"><h2 class="font-display text-3xl">Opening hours</h2><div class="mt-6 divide-y divide-line text-sm"><% [["Monday – Friday", "09:00 – 21:00"], ["Saturday", "09:00 – 22:00"], ["Sunday", "10:00 – 20:00"]].each do |day, hours| %><div class="flex justify-between py-4"><span><%= day %></span><strong><%= hours %></strong></div><% end %></div><p class="mt-5 flex items-center gap-2 text-sm text-copper"><%= icon "clock", class_name: "size-4" %>Usually responds within an hour</p></div></div>
    <div class="border-t border-line pt-12" id="services"><%= render "shared/section_heading", eyebrow: "Book your ritual", title: "Popular services", description: "Clear pricing, considered treatments, and a little more time for the details." %><div class="space-y-3"><% @services.each do |service| %><%= render "shared/service_row", service: service %><% end %></div></div>
    <div class="border-t border-line pt-12" id="staff"><%= render "shared/section_heading", eyebrow: "Meet the artists", title: "People who care about the craft." %><div class="grid gap-4 sm:grid-cols-3"><% @professionals.each do |professional| %><%= render "shared/professional_card", professional: professional %><% end %></div></div>
    <div class="grid gap-8 border-t border-line pt-12 lg:grid-cols-2" id="reviews"><div><p class="eyebrow mb-4">Client notes</p><h2 class="font-display text-4xl">“The kind of appointment you look forward to.”</h2><div class="mt-5"><%= render "shared/rating", rating: "4.9", reviews: 328 %></div></div><blockquote class="rounded-3xl bg-sand p-7 text-sm leading-7 text-muted">“Maya understood exactly what I wanted, and the whole studio feels so calm. I left feeling like myself, only fresher.”<footer class="mt-5 font-semibold text-ink">— Sarah Putri, regular client</footer></blockquote></div>
    <div class="border-t border-line pt-12" id="location"><%= render "shared/section_heading", eyebrow: "Visit Glow Studio", title: "Easy to find, worth the trip." %><div class="rounded-3xl border border-line bg-white p-7 sm:p-10"><p class="flex items-center gap-3 font-semibold"><%= icon "pin", class_name: "size-5 text-copper" %>Jl. Kemang Raya No. 18, Jakarta Selatan</p><p class="mt-3 text-sm leading-6 text-muted">A presentation-only location preview. Detailed directions will be available when booking is introduced.</p></div></div>
  </div>
</section>
